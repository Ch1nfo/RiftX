{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riftx.local/schemas/cli-json-v1.schema.json",
  "title": "RiftX CLI-owned JSON output contract v1",
  "description": "Schema for JSON objects owned by the RiftX CLI. Domain DTO output remains governed by codex-riftx-ipc.",
  "oneOf": [
    {
      "$ref": "#/$defs/configValidation"
    },
    {
      "$ref": "#/$defs/doctorReport"
    },
    {
      "$ref": "#/$defs/approvalDecision"
    },
    {
      "$ref": "#/$defs/operationSuccess"
    },
    {
      "$ref": "#/$defs/eventEnvelope"
    },
    {
      "$ref": "#/$defs/artifactExport"
    }
  ],
  "$defs": {
    "configValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "config"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "config": {
          "type": "string"
        }
      }
    },
    "daemonInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "daemonVersion"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "minimum": 1
        },
        "daemonVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "doctorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "config",
        "daemon"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "config": {
          "type": "string"
        },
        "daemon": {
          "$ref": "#/$defs/daemonInfo"
        }
      }
    },
    "approvalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "decision"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approve",
            "deny"
          ]
        }
      }
    },
    "operationSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data",
        "id"
      ],
      "properties": {
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {},
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifactExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output"
      ],
      "properties": {
        "output": {
          "type": "string"
        }
      }
    }
  },
  "x-riftx-contract-version": 1,
  "x-riftx-command-schemas": {
    "config validate --json": "#/$defs/configValidation",
    "doctor --json": "#/$defs/doctorReport",
    "approvals decide --json": "#/$defs/approvalDecision",
    "events --json": "#/$defs/eventEnvelope (newline-delimited stream)",
    "artifacts export --json": "#/$defs/artifactExport",
    "empty successful response --json": "#/$defs/operationSuccess"
  },
  "x-riftx-ipc-passthrough-contracts": {
    "engagements create|get|activate --json": "codex_riftx_ipc::Engagement",
    "engagements list --json": "Vec<codex_riftx_ipc::Engagement>",
    "approvals list --json": "Vec<codex_riftx_ipc::PendingApproval>",
    "llm profiles list --json": "codex_riftx_ipc::LlmProfileList",
    "llm profiles test --json": "codex_riftx_ipc::LlmConnectionTestResult",
    "tools list|doctor --json": "codex_riftx_tools::ToolInventory",
    "skills list|doctor --json": "codex_riftx_skills::SkillCatalog",
    "mode --json": "codex_riftx_ipc::Engagement",
    "turn --json": "codex_riftx_ipc::TurnAccepted",
    "interrupt --json": "codex_riftx_ipc::Engagement",
    "kill --json": "codex_riftx_ipc::DaemonControlStatus",
    "auto status|pause|resume|kill --json": "codex_riftx_core::AutoRun",
    "artifacts capture --json": "codex_riftx_ipc::Artifact",
    "artifacts list --json": "Vec<codex_riftx_ipc::Artifact>"
  },
  "x-riftx-exit-codes": {
    "success": 0,
    "internal": 1,
    "argumentOrConfig": 2,
    "daemonOrProtocol": 3,
    "requestRejected": 4,
    "localIo": 5
  }
}
