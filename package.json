{
  "name": "riftx",
  "version": "0.1.0",
  "type": "module",
  "description": "Local Web UI for the RiftX authorized security testing agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ch1nfo/RiftX.git"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "rx": "bin/rx.mjs"
  },
  "files": [
    "bin/",
    "public/",
    "next.config.mjs",
    ".next/",
    "!.next/cache/",
    "!.next/types/"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests bin",
    "test": "tsx --test 'src/**/*.test.ts'",
    "postinstall": "playwright install chromium",
    "prepare": "npm run build",
    "test:e2e": "playwright test",
    "test:benchmark": "node --test --test-timeout=60000 --import tsx src/server/benchmark/controller.integration.ts",
    "benchmark": "node --import tsx src/server/benchmark/entry.ts",
    "test:hosted": "node --test --import tsx src/server/benchmark/hosted.integration.ts"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sinclair/typebox": "^0.34.33",
    "next": "^15.5.6",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
